# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://kafka_app:password@localhost:5432/kafka_app

# Only needed when the frontend is served from a different origin (production)
CORS_ALLOWED_ORIGINS=http://localhost:5174

# JWT lifetimes
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# ASK KAFKA
# LLM_PROVIDER: "groq" (free tier, GPT-OSS 120B) | "anthropic" (paid) | "fake" (offline demo)
LLM_PROVIDER=groq
# Create a free key at https://console.groq.com/keys — never commit it.
GROQ_API_KEY=
# Optional overrides (empty/0 = provider default: openai/gpt-oss-120b, 3000 tokens per reply)
LLM_MODEL=
LLM_EFFORT=medium
LLM_MAX_TOKENS=0
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ASSISTANT_RATE=40/hour
